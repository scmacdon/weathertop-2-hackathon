aws dynamodb create-table --table-name TestRunSummaries --attribute-definitions AttributeName=RunId,AttributeType=S --key-schema AttributeName=RunId,KeyType=HASH --provisioned-throughput ReadCapacityUnits=5,WriteCapacityUnits=5

