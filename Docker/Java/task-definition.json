{
    "family": "java-v2-tests-task",
    "networkMode": "awsvpc",
    "requiresCompatibilities": ["FARGATE"],
    "cpu": "1024",
    "memory": "2048",
    "executionRoleArn": "arn:aws:iam::814548047983:role/ecsTaskExecutionRole", 
    "taskRoleArn": "arn:aws:iam::814548047983:role/java-v2-tests-task-role",
    "containerDefinitions": [
      {
        "name": "java-v2-tests-container",
        "image": "814548047983.dkr.ecr.us-east-1.amazonaws.com/java-v2-tests:latest",
        "essential": true,
        "logConfiguration": {
          "logDriver": "awslogs",
          "options": {
            "awslogs-group": "/ecs/java-v2-tests",
            "awslogs-region": "us-east-1",
            "awslogs-stream-prefix": "ecs"
          }
        }
      }
    ]
  }
  